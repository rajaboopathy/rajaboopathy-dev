---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// Format date utility
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};

// Sort posts by date descending
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Essays | Tech Synthesis" description="Long-form essays on systems architecture, scalability, and engineering leadership.">
  <div class="blog-header-section">
    <div class="container text-center">
      <h1 class="gradient-text page-title">Technical Essays</h1>
      <p class="subtitle">Deep dives on scaling systems, building engineering culture, and strategic technology choices.</p>
    </div>
  </div>

  <div class="container section">
    <div class="grid">
      {sortedPosts.map(post => (
        <Card
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          date={formatDate(post.data.pubDate)}
          category={post.data.category}
          tags={post.data.tags}
        />
      ))}
      {sortedPosts.length === 0 && (
        <p class="no-posts">No essays published yet. Check back later!</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-header-section {
    padding: 4rem 0 2rem;
    position: relative;
  }

  .text-center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
  }

  .section {
    padding: 3rem 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .no-posts {
    color: var(--text-muted);
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    background-color: var(--bg-secondary);
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }
</style>
