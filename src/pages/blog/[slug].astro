---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format date utility
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={`${post.data.title} | Tech Synthesis`} description={post.data.description}>
  <article class="article-container">
    <header class="article-header">
      <div class="article-meta">
        <a href="/blog" class="back-link">&larr; Back to essays</a>
        <span class="separator">|</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.category && (
          <>
            <span class="separator">|</span>
            <span class="category">{post.data.category}</span>
          </>
        )}
      </div>
      
      <h1 class="gradient-text article-title">{post.data.title}</h1>
      
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags-container">
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="markdown-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: 760px;
    margin: 4rem auto 0;
    padding: 0 1.5rem;
  }

  .article-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--accent-secondary);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .separator {
    color: var(--border-color);
  }

  .category {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .article-title {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  /* Markdown Content Styling overrides */
  .markdown-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
  }

  .markdown-content :global(h2) {
    font-size: 1.8rem;
    margin: 2.5rem 0 1.25rem;
    color: var(--text-primary);
  }

  .markdown-content :global(h3) {
    font-size: 1.4rem;
    margin: 2rem 0 1rem;
    color: var(--text-primary);
  }

  .markdown-content :global(ul), .markdown-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .markdown-content :global(li) {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .markdown-content :global(li strong) {
    color: var(--text-primary);
  }

  .markdown-content :global(blockquote) {
    border-left: 4px solid var(--accent-primary);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    padding: 1rem 1.5rem;
    border-radius: 0 8px 8px 0;
  }

  .markdown-content :global(pre) {
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    margin-bottom: 1.75rem;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 2rem;
    }
  }
</style>
