---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";

const blogPosts = await getCollection("blog");
const gardenPosts = await getCollection("garden");

// Format date utility
const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
};

// Sort and get latest items
const latestBlog = blogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestGarden = gardenPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout
  title="Tech Synthesis | Distinguished Engineer Portfolio"
  description="High-signal, low-noise reflections, book log, and engineering leadership essays by a technology leader."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge">Distinguished Engineer &amp; Architect</span>
        <h1 class="gradient-text hero-title">High Signal,<br />Low Noise.</h1>
        <p class="hero-description">
          Welcome to my digital space. Here, I synthesize complex systems
          architecture, share insights from technology leadership, and build a
          public log of technical book summaries. Focus on depth and principles
          over volume and trends.
        </p>
        <div class="hero-actions">
          <a href={`${import.meta.env.BASE_URL}blog`} class="btn btn-primary">Read Essays</a>
          <a href={`${import.meta.env.BASE_URL}garden`} class="btn btn-secondary">Explore Garden</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
        <div class="visual-card">
          <div class="code-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="file-name">brand-strategy.json</span>
          </div>
          <pre
            class="code-body"><code>&#123;
  "profile": "Distinguished Engineer",
  "focus": ["Leadership", "Systems Design"],
  "philosophy": "High Signal, Low Noise",
  "activity": "Reading, Synthesizing, Writing"
&#125;</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Essays Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Latest Essays</h2>
        <a href={`${import.meta.env.BASE_URL}blog`} class="section-link">All essays &rarr;</a>
      </div>
      <div class="grid">
        {
          latestBlog.map((post) => (
            <Card
              href={`${import.meta.env.BASE_URL}blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.pubDate)}
              category={post.data.category}
              tags={post.data.tags}
            />
          ))
        }
        {
          latestBlog.length === 0 && (
            <p class="no-posts">No essays published yet. Check back soon!</p>
          )
        }
      </div>
    </div>
  </section>

  <!-- Featured Garden Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Digital Garden</h2>
        <a href={`${import.meta.env.BASE_URL}garden`} class="section-link">All reading logs &rarr;</a>
      </div>
      <div class="grid">
        {
          latestGarden.map((post) => (
            <Card
              href={`${import.meta.env.BASE_URL}garden/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.pubDate)}
              category={post.data.category}
              tags={post.data.tags}
            />
          ))
        }
        {
          latestGarden.length === 0 && (
            <p class="no-posts">
              No garden syntheses published yet. Check back soon!
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero {
    padding: 6rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    background-color: var(--accent-glow);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--border-glow);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.8rem;
    line-height: 1.1;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: var(--bg-primary);
  }

  .btn-primary:hover {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--accent-glow);
  }

  .btn-secondary {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background-color: var(--bg-secondary);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  /* Hero Visuals */
  .hero-visual {
    position: relative;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
  }

  .orb-1 {
    width: 250px;
    height: 250px;
    background-color: hsla(263, 90%, 65%, 0.3);
    top: -20%;
    right: -10%;
  }

  .orb-2 {
    width: 200px;
    height: 200px;
    background-color: hsla(217, 91%, 60%, 0.2);
    bottom: -20%;
    left: -10%;
  }

  .visual-card {
    background-color: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    box-shadow: 0 20px 40px var(--glass-shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .code-header {
    background-color: rgba(255, 255, 255, 0.03);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red {
    background-color: #ff5f56;
  }
  .dot.yellow {
    background-color: #ffbd2e;
  }
  .dot.green {
    background-color: #27c93f;
  }

  .file-name {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .code-body {
    padding: 1.5rem;
    font-size: 0.85rem;
    color: var(--accent-secondary);
  }

  /* Section Styles */
  .section {
    padding: 5rem 0;
    border-top: 1px solid var(--border-color);
  }

  .section-alt {
    background-color: var(--bg-secondary);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .section-title {
    position: relative;
    padding-bottom: 0.5rem;
  }

  .section-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--accent-primary);
    border-radius: 2px;
  }

  .section-link {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .no-posts {
    color: var(--text-muted);
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    background-color: var(--bg-tertiary);
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-title {
      font-size: 3rem;
    }
    .hero-visual {
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
    }
  }
</style>
