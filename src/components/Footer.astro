---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-left">
      <p class="copyright">&copy; {currentYear} Tech Synthesis. All rights reserved.</p>
      <p class="tagline">High signal, low noise thought leadership.</p>
    </div>
    
    <div class="footer-right">
      <span>Built with</span>
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="astro-link">Astro</a>
      <span>&amp;</span>
      <span class="css-link">Vanilla CSS</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 3rem 0;
    background-color: var(--bg-secondary);
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-left p {
    margin: 0;
  }

  .copyright {
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .astro-link {
    color: var(--accent-secondary);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .astro-link:hover {
    color: var(--text-primary);
  }

  .css-link {
    color: var(--accent-primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .footer-container {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }
    .footer-right {
      justify-content: center;
    }
  }
</style>
