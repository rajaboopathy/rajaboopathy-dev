---
interface Props {
  href: string;
  title: string;
  description: string;
  date: string;
  category?: string;
  tags?: string[];
}

const { href, title, description, date, category, tags = [] } = Astro.props;
---

<article class="card gradient-border">
  <a href={href} class="card-link-wrapper">
    <div class="card-content">
      <div class="card-meta">
        <time datetime={date} class="card-date">{date}</time>
        {category && <span class="card-category">{category}</span>}
      </div>
      
      <h3 class="card-title">{title}</h3>
      
      <p class="card-description">{description}</p>
      
      {tags.length > 0 && (
        <div class="card-tags">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
      
      <div class="read-more">
        <span>Read synthesis</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-normal);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card-link-wrapper {
    display: block;
    height: 100%;
    padding: 2rem;
    border-radius: 12px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  .card-date {
    color: var(--text-muted);
  }

  .card-category {
    color: var(--accent-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .card-link-wrapper:hover .card-title {
    color: var(--accent-primary);
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-tertiary);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-secondary);
    transition: color var(--transition-fast);
    margin-top: auto;
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .card-link-wrapper:hover .read-more {
    color: var(--accent-primary);
  }

  .card-link-wrapper:hover .arrow-icon {
    transform: translateX(4px);
  }
</style>
