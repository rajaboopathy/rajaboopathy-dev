---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Distinguished Engineer | Portfolio & Digital Garden", 
  description = "Reflections, syntheses, and principles of an engineering leader." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="layout-wrapper">
      <Header />
      <main class="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Load and render Mermaid diagrams if present
      document.addEventListener('DOMContentLoaded', async () => {
        const codeBlocks = document.querySelectorAll(
          'pre[data-language="mermaid"], pre > code.language-mermaid, pre > code.mermaid, pre.mermaid > code'
        );
        if (codeBlocks.length > 0) {
          try {
            const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10.9.0/dist/mermaid.esm.min.mjs');
            const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            mermaid.initialize({
              startOnLoad: false,
              theme: isDark ? 'dark' : 'default',
              securityLevel: 'loose',
            });

            codeBlocks.forEach((el) => {
              const preEl = el.tagName === 'PRE' ? el : el.parentElement;
              if (!preEl) return;
              
              const mermaidDiv = document.createElement('div');
              mermaidDiv.className = 'mermaid';
              // textContent extracts raw text, stripping Shiki's span tags while preserving newlines
              mermaidDiv.textContent = preEl.textContent;
              
              preEl.replaceWith(mermaidDiv);
            });

            await mermaid.run();
          } catch (err) {
            console.error('Failed to render Mermaid diagrams:', err);
          }
        }
      });
    </script>
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--bg-gradient);
  }

  .main-content {
    flex: 1;
    padding-top: 80px; /* Offset for glassmorphic fixed header */
    padding-bottom: 4rem;
  }

  :global(.mermaid) {
    display: flex;
    justify-content: center;
    margin: 2rem auto;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    overflow-x: auto;
    max-width: 100%;
  }
</style>
